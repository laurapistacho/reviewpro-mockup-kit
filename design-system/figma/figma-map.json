{
 "_about": "Figma UI App library (file ubE7R2jeqiwS8BZ4a5vwHw) component sets -> kit markup. Used by .kiro/scripts/figma-outline.py to turn any Figma frame built with the library into kit classes. Variant rules: \"@cls\" replaces the base class, \"+cls\" adds a class, \"{base}-x\" adds a modifier of the current base, \"attr:x\" adds an HTML attribute, \"=\" means no change. Missing = the library has it and the kit does not (see design-system/figma/README.md).",
 "sets": {
  "Button": {
   "kit": "rp-main-button",
   "tag": "button",
   "doc": "rp-buttons.md",
   "variants": {
    "Variant=Outlined": "@rp-default-button",
    "Variant=Ghost": "@rp-ghost-button",
    "Variant=Filled": "=",
    "Style=Primary": "=",
    "Style=Secondary": "{base}-secondary",
    "Style=Danger": "{base}-danger",
    "Style=Disabled": "attr:disabled",
    "Size=Large": "=",
    "Size=Small": "{base}-size-small"
   },
   "notes": "Outlined Primary = rp-default-button-primary, Outlined Secondary = rp-default-button. Ghost: kit default is Figma Small; Figma Large = rp-ghost-button-size-medium; Secondary ghost = rp-ghost-button-inherit with a grey parent. A leading icon is the first .rp-icon (32px large, 24px small)."
  },
  "IconButton": {
   "kit": "rp-icon-button",
   "tag": "button",
   "doc": "rp-buttons.md",
   "variants": {
