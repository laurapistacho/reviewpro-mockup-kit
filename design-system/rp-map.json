{
 "_about": "Source of truth for kit names. Every class in foundation/shared.css is listed here: a component root, one of its props, a part, a runtime state, or kit-only layout. React names and props come from @reviewpro/ui-components (frontend-workspace/libs/ui-components/src). build-docs.py writes HANDOFF.md and the first line of each component doc from this file; check-mockup.py --all fails when shared.css has a class that is not here.",
 "rules": {
  "root": "rp-{component} = the React component (kebab case of its name)",
  "prop": "rp-{component}-{value} or rp-{component}-{prop}-{value} = one prop value; no class = the default value",
  "boolean": "rp-{component}-{prop} = a boolean prop set to true (rp-main-button-danger = danger)",
  "disabled": "the disabled attribute on a native control = disabled prop",
  "kit": "kit-{name} = page layout of the kit, no React component (write it as layout in the page)"
 },
